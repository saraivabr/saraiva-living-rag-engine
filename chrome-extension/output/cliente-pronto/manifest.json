{
  "manifest_version": 3,
  "name": "Cliente Pronto — Saraiva.ai",
  "short_name": "Cliente Pronto",
  "version": "0.1.0",
  "minimum_chrome_version": "114",
  "description": "Transforma um negócio escolhido em dossiê comercial e envia a abordagem revisada pelo WhatsApp Web.",
  "action": {
    "default_title": "Abrir Cliente Pronto"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "sidePanel",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://52cv7zdc64autz4ltjj6h7uce40ktyfd.lambda-url.us-east-1.on.aws/*",
    "https://web.whatsapp.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
